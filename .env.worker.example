# Copy to .env.worker on the Mac; it is ignored by Git. Do not paste values in chat.
DRIPCUT_WORKER_API_URL=https://YOUR-RENDER-API.onrender.com
DRIPCUT_WORKER_TOKEN=
DRIPCUT_WORKER_ID=mac-youtube-worker-1
DRIPCUT_YOUTUBE_ACQUISITION_MODE=local
# Read fresh YouTube cookies from this Mac's signed-in browser on every job.
# Supported values include chrome, brave, edge, firefox, and safari.
DRIPCUT_YOUTUBE_COOKIES_FROM_BROWSER=chrome
DRIPCUT_YOUTUBE_BROWSER_PROFILE=
DRIPCUT_STORAGE_PROVIDER=r2
DRIPCUT_STORAGE_BUCKET=
DRIPCUT_STORAGE_PREFIX=dripcut
DRIPCUT_STORAGE_ENDPOINT_URL=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DRIPCUT_WORKER_MAX_SOURCE_MB=2048
DRIPCUT_WORKER_POLL_SECONDS=8
