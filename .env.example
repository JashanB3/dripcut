# Backend-only transcription configuration. Never prefix secrets with VITE_.
GROQ_API_KEY=
DRIPCUT_TRANSCRIPTION_PROVIDER=groq
DRIPCUT_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Browser/API deployment configuration.
DRIPCUT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=

# Render Free safety. Local development keeps its normal two-worker default.
DRIPCUT_MAX_WORKERS=1
