# Copy this file to the ignored root .env. Use fake/example values only in this tracked template.
# Backend-only transcription configuration. Never prefix secrets with VITE_.
GROQ_API_KEY=
DRIPCUT_TRANSCRIPTION_PROVIDER=groq
DRIPCUT_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Browser/API deployment configuration.
DRIPCUT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=
# Optional public analytics identifiers. Configure GA directly, GTM, or both.
# If GTM also loads GA, leave VITE_GA_MEASUREMENT_ID empty to avoid duplicate page views.
VITE_GA_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
# Public UI availability only; these flags do not replace backend authorization.
VITE_YOUTUBE_PUBLISHING_BETA=true
VITE_EXPERIMENTAL_TOOLS=false

# SaaS identity and tenant persistence. Production must use Supabase.
DRIPCUT_ENV=development
DRIPCUT_AUTH_PROVIDER=local
DRIPCUT_TENANT_PROVIDER=local
DRIPCUT_USAGE_PROVIDER=local
DRIPCUT_AUTH_REQUIRED=1
# Comma-separated local-development emails only. Production uses profiles.is_dripcut_admin.
DRIPCUT_ADMIN_EMAILS=
DRIPCUT_FRONTEND_URL=http://127.0.0.1:5173
DRIPCUT_COOKIE_SECURE=0
# Enabled automatically in production. Uncomment only to force it in proxy/test environments.
# DRIPCUT_CSRF_PROTECTION=1
# Per-process burst protection. Use a shared Redis limiter when horizontally scaling.
DRIPCUT_RATE_LIMIT_WINDOW_SECONDS=60
DRIPCUT_RATE_LIMIT_AUTH=30
DRIPCUT_RATE_LIMIT_EXPENSIVE=30
DRIPCUT_RATE_LIMIT_UPLOAD=20
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side scheduler access only. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Central plan overrides. Omit to use the built-in FREE, CREATOR and PRO limits.
DRIPCUT_LOCAL_PLAN=free
# DRIPCUT_PLAN_ENTITLEMENTS_JSON={"free":{"video_processing_minutes":10}}

# Private media storage. Use `s3` for AWS S3 or `r2` with an R2 endpoint URL.
DRIPCUT_STORAGE_PROVIDER=local
DRIPCUT_STORAGE_BUCKET=
DRIPCUT_STORAGE_PREFIX=dripcut
DRIPCUT_STORAGE_ENDPOINT_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uploads are also checked by FFprobe after transfer.
DRIPCUT_MAX_VIDEO_DURATION_SECONDS=14400
# Small production VMs should keep transient acquisition/render data outside
# persistent state and reject new work before the boot disk becomes unsafe.
# DRIPCUT_TEMP=/tmp/dripcut
# DRIPCUT_MIN_FREE_DISK_MB=1536
# DRIPCUT_MAX_UPLOAD_MB=512
# DRIPCUT_MAX_ACTIVE_JOBS_PER_USER=5
# DRIPCUT_FFMPEG_TIMEOUT_SECONDS=1800

# Local development defaults to two workers. Hosted Docker images force one by default.
# DRIPCUT_MAX_WORKERS=2

# Server-side AI analysis. NVIDIA is primary when configured; Ollama is the fallback.
DRIPCUT_AI_PROVIDER=auto
NVIDIA_API_KEY=
DRIPCUT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DRIPCUT_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DRIPCUT_OLLAMA_HOST=http://127.0.0.1:11434
DRIPCUT_OLLAMA_MODEL=qwen2.5:3b

# Official social OAuth and publishing. Register these exact callback URLs:
# <DRIPCUT_PUBLIC_API_URL>/api/social/youtube/callback
# <DRIPCUT_PUBLIC_API_URL>/api/social/instagram/callback
DRIPCUT_PUBLIC_API_URL=http://127.0.0.1:8000
DRIPCUT_SOCIAL_STORE=local
DRIPCUT_CREDENTIAL_ENCRYPTION_KEY=
DRIPCUT_OAUTH_STATE_SECRET=
DRIPCUT_YOUTUBE_CLIENT_ID=
DRIPCUT_YOUTUBE_CLIENT_SECRET=
DRIPCUT_YOUTUBE_PRIVACY=private
DRIPCUT_YOUTUBE_CATEGORY_ID=22
DRIPCUT_META_APP_ID=
DRIPCUT_META_APP_SECRET=
DRIPCUT_META_GRAPH_VERSION=v23.0

# Optional production YouTube verification. Keep these backend-only.
DRIPCUT_YOUTUBE_POT_PROVIDER_URL=
# On Render, create a Secret File at /etc/secrets/youtube-cookies.txt before enabling this.
DRIPCUT_YOUTUBE_COOKIE_FILE=
# Trusted desktop workers can read the operator's current browser session on
# every import, avoiding repeated cookie-file exports. Never enable this on a
# shared cloud API host.
DRIPCUT_YOUTUBE_COOKIES_FROM_BROWSER=
DRIPCUT_YOUTUBE_BROWSER_PROFILE=

# Trusted Mac acquisition worker. Leave `local` until the migration is applied
# and the worker is configured. These values are API-only; never use VITE_ names.
DRIPCUT_YOUTUBE_ACQUISITION_MODE=local
DRIPCUT_WORKER_ENABLED=false
DRIPCUT_WORKER_TOKEN=
DRIPCUT_WORKER_LEASE_SECONDS=120
